# ==============================================================================
# ALC Support — Discord Hermes Bot Configuration
# ==============================================================================

# 1. Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN="your_discord_bot_token_here"

# 2. Authorized Discord User IDs (comma-separated, e.g. Pastor Craig's Discord User ID)
# Leave blank to permit any server member with access to the bot's channel
AUTHORIZED_USER_IDS=""

# 3. GitHub Personal Access Token (PAT) for 'alckellogg' account
# Create token at: https://github.com/settings/tokens (classic with 'repo' scope or fine-grained with read/write repo permissions)
GITHUB_PAT="ghp_your_alckellogg_personal_access_token_here"
GITHUB_USERNAME="alckellogg"
GITHUB_REPO="dsackr/american-lutheran-church-kellogg"
GITHUB_BRANCH="main"

# 4. Hermes LLM Backend Configuration
# Supports OpenRouter (Nous Hermes 3), OpenAI, or local vLLM/Ollama
HERMES_API_KEY="your_openrouter_or_openai_api_key_here"
HERMES_BASE_URL="https://openrouter.ai/api/v1"
HERMES_MODEL="nousresearch/hermes-3-llama-3.1-70b"
